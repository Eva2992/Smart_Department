  "entryPoints": ["src"],
  "entryPointStrategy": "expand",
  "out": "docs/api",
  "name": "Smart Department Backend API",
  "readme": "none",
  "exclude": ["**/*.test.ts", "**/node_modules/**", "**/generated/**"],
  "tsconfig": "tsconfig.json",
  "plugin": [],
