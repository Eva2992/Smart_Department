# Server Environment Configuration
NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/smartdept?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/smartdept?sslmode=require"

# JWT Secrets
JWT_ACCESS_SECRET="smart_schedular_jwt_access_secret_key_change_in_production"
JWT_REFRESH_SECRET="smart_schedular_jwt_refresh_secret_key_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="*"
